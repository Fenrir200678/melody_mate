{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@markov-tables/*": ["./markov-tables/*"],
      "#platform-audio": ["./src/stores/browser-audio.store.ts"],
      "#platform-midi": ["./src/platform/browser-midi.ts"],
      "#sound-mix-dock": ["./src/components/layout/SoundMixDock.vue"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "tests/**/*.ts", "markov-tables/*.json", "package.json"]
}
