{
  "name": "melodymate",
  "private": false,
  "version": "2.1.7",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --build --noEmit",
    "check": "pnpm lint && pnpm type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@lucide/vue": "^1.45.0",
    "@vercel/analytics": "^2.0.1",
    "@vueuse/core": "^14.4.0",
    "midi-writer-js": "^3.2.1",
    "pinia": "^4.0.3",
    "tonal": "^6.4.3",
    "tone": "^15.1.22",
    "vue": "^3.5.42",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
